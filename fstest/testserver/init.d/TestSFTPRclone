#!/usr/bin/env bash

set -e

NAME=rclone-serve-sftp
USER=rclone
PASS=CranesBallotDorsey5
IP=127.0.0.1
PORT=28621

start() {
    # --vfs-cache-mode writes lets the server accept random-access writes
    # (truncate and writes at arbitrary offsets), as required to test
    # multi-thread uploads. Without it serve sftp rejects SetStat with
    # SSH_FX_FAILURE.
    run rclone serve sftp --user $USER --pass $PASS --addr ${IP}:${PORT} --vfs-cache-mode writes ${DATADIR}
    
    echo type=sftp
    echo host=${IP}
    echo port=$PORT
    echo user=$USER
    echo pass=$(rclone obscure $PASS)
    echo _connect=${IP}:${PORT}
}

. $(dirname "$0")/rclone-serve.bash
